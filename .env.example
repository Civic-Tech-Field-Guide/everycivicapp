# Copy to .env and fill in your keys, or set these as GitHub Actions secrets

# Airtable — personal access token with read access to Listings/Links/Categories
# and write access to Listings (for the "shared on @everytool" tag)
AIRTABLE_API_KEY=your_airtable_personal_access_token_here

# Bluesky — direct API (Settings → App Passwords in the Bluesky app)
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Mastodon — direct API (instance Settings → Development → New Application)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here

# Buffer — used for Threads + Instagram only (Settings → API in your Buffer account)
BUFFER_API_KEY=your_buffer_api_key_here

# Optional
# DRY_RUN=true   # print a post preview without posting or tagging anything
